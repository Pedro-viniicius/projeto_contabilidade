# Variáveis de ambiente do Clareza.
# Copie para `.env.local` se precisar sobrescrever algo.
# NENHUMA é obrigatória para rodar o projeto — e nenhuma é segredo.

# URL pública do site. Usada em metadata, Open Graph, robots e sitemap.
# Em produção, aponte para o domínio real.
# Deixe vazio na Vercel: a URL do deploy é detectada automaticamente.
# Preencha apenas quando houver domínio próprio.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Imprime os eventos de analytics no console do navegador.
# Útil para conferir o que seria enviado quando houver plataforma.
NEXT_PUBLIC_ANALYTICS_DEBUG=false
